# Recovery entry-point init.rc for nova9z (TRG-AN00 / Hi nova 9z)
#
# 这个文件是"从源头修复"灰屏黑屏循环的关键。
#
# 问题背景：
#   你用的 TWRP 源码树在编译时，只把 TWRP 的 init.recovery.*.rc 片段
#   （service / usb / ldconfig / hlthchrg）复制到了 recovery ramdisk 根，
#   却【没有】把入口脚本 /init.rc 组装/复制进去。
#   而 Android 的 init（/system/bin/init）启动时只自动读取根 /init.rc 和
#   /system/etc/init/*.rc，不会去扫根目录里那些 init.recovery.*.rc 片段。
#   于是片段全成了"孤儿"——recovery 服务从不注册、也没有 class_start 触发，
#   init 起来后无事可做 → 华为看门狗超时 → 灰屏→黑屏→重启循环。
#
# 这个 nova9z 是独立 recovery 分区机型（非 recovery-as-boot / 非 A/B），
# 所以 recovery 必须自带根 /init.rc 作为入口。本文件补上它。
#
# 用法：经 device.mk 里的 PRODUCT_COPY_FILES 复制到
#       $(TARGET_RECOVERY_ROOT_OUT)/init.rc，重新编译即自动生效，
#       无需每次手工改 ramdisk。

on early-init
    # TWRP 需要宽松 SELinux 才能正常挂载/操作分区
    write /sys/fs/selinux/enforce 0

# 导入 TWRP 自带的辅助片段（USB、linker 配置、充电等）
import /init.recovery.usb.rc
import /init.recovery.ldconfig.rc
import /init.recovery.hlthchrg.rc

# 注意：此处【不】import init.recovery.service.rc，因为它的 service 定义
# 直接写在这里，避免重复定义 service recovery 导致 init 报错。

on boot
    # 拉起 default 类的所有服务（含下面的 recovery 服务）
    class_start default

# TWRP recovery 本体（SAR 式：recovery 二进制位于 ramdisk 内的 system/bin）
service recovery /system/bin/recovery
    socket recovery stream 422 system system
    seclabel u:r:recovery:s0
